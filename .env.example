# Copie este arquivo para ".env" se quiser sobrescrever a chave do config.json.
# A chave publica da API do Datajud e divulgada pelo CNJ em:
#   https://datajud-wiki.cnj.jus.br/api-publica/acesso
# Se a chave padrao parar de funcionar (HTTP 401/403), pegue a atual nessa pagina.
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==

# Fase 2 (consultar.bat / segundo cerebro). Crie em https://openrouter.ai/keys
# Para a COLETA e' opcional. Para a interface web e' OBRIGATORIA: sem ela toda
# consulta morre em SemChave (src/rag/llm.py).
OPENROUTER_API_KEY=

# Deploy na VPS (ver DEPLOY.md). O Caddy tira o certificado para este dominio,
# entao ele tem de ja' apontar para o IP da VPS antes do primeiro `up`.
# So' e' lido pelo docker-compose.yml; em Windows nao serve para nada.
DOMINIO=cerebro.seudominio.com.br
